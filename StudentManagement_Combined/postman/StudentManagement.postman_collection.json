        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": 1,\n  \"studentName\": \"Riya Sharma\",\n  \"email\": \"riya@example.com\",\n  \"courseName\": \"CSE\",\n  \"programmingScore\": 88,\n  \"mathematicsScore\": 92,\n  \"technicalSkills\": [\n    \"Java\",\n    \"SQL\",\n    \"Spring Boot\"\n  ]\n}"
        }
      }
    },
    {
