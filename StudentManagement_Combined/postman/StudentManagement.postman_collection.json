          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"programmingScore\": 95,\n  \"mathematicsScore\": 90,\n  \"technicalSkills\": [\n    \"Java\",\n    \"SQL\",\n    \"Spring Boot\",\n    \"Docker\"\n  ]\n}"
        }
